mainmenu "ghanode SiWx917 sensor node"

menu "ghanode"

config GHANODE_MQTT_TLS
	bool "MQTT over TLS"
	default y
	depends on MQTT_LIB_TLS
	help
	  The broker must present a certificate for SECRET_MQTT_TLS_HOSTNAME
	  that chains to ISRG Root X1 (certs/isrg_root_x1.pem). The node does
	  not keep a wall clock for mbed TLS, so certificate dates are not
	  checked. Disable for plain MQTT.

config GHANODE_MQTT_BROKER_PORT
	int "MQTT broker port"
	default 8883 if GHANODE_MQTT_TLS
	default 1883

config GHANODE_MQTT_TOPIC
	string "MQTT topic readings are published to"
	default "ghanode/sensor"

config GHANODE_SAMPLE_INTERVAL_MS
	int "Sample period in milliseconds"
	default 20000

config GHANODE_READING_QUEUE_LEN
	int "Readings kept while the broker cannot be reached"
	range 1 1024
	default 30
	help
	  Bridges short outages such as a Wi-Fi handover. 30 readings at the
	  default 20 s period cover ten minutes, the same as the recovery
	  ladder's grace period before an MCU reset, which empties the queue.
	  When the queue is full the oldest reading is dropped.

config GHANODE_SNTP_RESYNC_S
	int "Seconds between SNTP queries once synced"
	default 3600

config GHANODE_SNTP_RETRY_S
	int "Seconds before retrying a failed SNTP query"
	default 60

config GHANODE_WIFI_COUNTRY
	string "Wi-Fi regulatory country code (ISO 3166-1 alpha-2)"
	default "DK"
	help
	  The NWP's default region is US, which only scans channels 1-11. Any
	  EU country code selects the EU region and enables channels 12 and 13.

endmenu

source "Kconfig.zephyr"
